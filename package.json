{
  "name": "pi-for-claude",
  "version": "0.1.1",
  "description": "Allow Claude Code to delegate tasks to the Pi coding agent.",
  "license": "MIT",
  "author": "ahalekelly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahalekelly/pi-for-claude.git"
  },
  "bugs": "https://github.com/ahalekelly/pi-for-claude/issues",
  "homepage": "https://github.com/ahalekelly/pi-for-claude#readme",
  "type": "module",
  "bin": {
    "pi-for-claude": "dist/pi-for-claude.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist",
    "models.json",
    "prompts",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy-build-assets",
    "copy-build-assets": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist/extensions/sandbox',{recursive:true});fs.copyFileSync('src/extensions/sandbox/sandbox.json','dist/extensions/sandbox/sandbox.json')\"",
    "prepare": "npm run build && npm run update-instructions",
    "test": "node --test tests/core.test.ts tests/instructions.test.ts tests/runner.test.ts tests/sandbox.test.ts tests/setup.test.ts tests/update.test.ts",
    "update-instructions": "node dist/update-instructions.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.67",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "agent-browser": "^0.33.2",
    "pi-agent-browser-native": "^0.3.0",
    "pi-web-access": "^0.18.0",
    "shell-quote": "1.10.0",
    "trash-cli": "7.2.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/shell-quote": "1.7.5",
    "typescript": "^5.9.0"
  }
}
